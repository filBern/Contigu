<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roslyn-based diagnostic dump of the WHOLE project (Core, Data, Presentation) without Unity installed: UnityEngine types come from
       the UnityEngine.Modules package, uGUI types are missing (reported as unresolved). Used to compare "before vs after" a refactor:
       the multiset of diagnostics, including method bodies, must not change. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" GeneratePathProperty="true" />
  </ItemGroup>
</Project>
